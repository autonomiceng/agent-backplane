{
	auto_https disable_redirects
	skip_install_trust
}

(ca-acme) {
	tls {
		issuer acme
	}
}

(ca-internal) {
	tls internal
}

(operator-deny) {
	@operator path_regexp (?i)^/+(health/+operations|metrics)\.*(/|$)
	respond @operator 404
	# Public ingress strips the token; direct server access can unlock readiness details.
	@ready path /health/ready /health/ready/*
	request_header @ready -Authorization
}

:80 {
	route {
		@health path /health
		respond @health 200
		import operator-deny
		redir {$BP_PUBLIC_URL}{uri} 308
	}
}

https://{$BP_PUBLIC_HOST} {
	import ca-{$BP_EDGE_CA}
	header Strict-Transport-Security "max-age=31536000"

	route {
		import operator-deny
		# Edge and server share default and external BP_PLATFORM_NETWORK; server resolves on both.
		# Only server -> http://workerd:8080 is confined to default; platform peers reach server in plaintext.
		# Plaintext upstreams require a trusted host and Docker peers (ADR-0021).
		# Restrict Docker access and network membership; isolate untrusted peers or use authenticated HTTPS.
		reverse_proxy server:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
		}
	}
}
