{
	auto_https disable_redirects
	skip_install_trust
	# IP clients omit SNI; Docker forwards to a container address.
	default_sni 127.0.0.1
	servers {
		trusted_proxies static {$BP_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

(operator-deny) {
	@operator path_regexp (?i)^/+(health/+operations|metrics)\.*(/|$)
	respond @operator 404
	@ready path /health/ready /health/ready/*
	request_header @ready -Authorization
}

(upstream) {
	# Plaintext upstreams require a trusted host and Docker peers (ADR-0021).
	reverse_proxy server:3000 {
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
	}
}

# Native console requests share one origin for assets, STS, admin and S3 APIs.
(rustfs-access) {
	@disabled expression `'{$BP_RUSTFS_CONSOLE:false}' != 'true'`
	respond @disabled "" 404
	@denied not client_ip {$BP_RUSTFS_CONSOLE_ALLOW:127.0.0.1/8 ::1}
	respond @denied "" 404
}

(rustfs-routes) {
	route {
		import rustfs-access
		@landing {
			path /
			method GET HEAD
			header Accept *text/html*
		}
		redir @landing /rustfs/console/ 302
		# Host, scheme and port are part of native console and SigV4 authority.
		reverse_proxy rustfs:9001
	}
}

(rustfs-local-false) {
}
(rustfs-local-true) {
	https://{$BP_RUSTFS_HOST:rustfs.localhost} {
		tls internal
		import access-log
		import rustfs-routes
	}
}
(rustfs-public-false) {
}
(rustfs-public-true) {
	https://{$BP_RUSTFS_HOST:rustfs.localhost} {
		tls {
			issuer acme
		}
		import access-log
		import rustfs-routes
	}
}

(mode-local) {
    import rustfs-local-{$BP_RUSTFS_CONSOLE:false}
    http://{$BP_RUSTFS_HOST:rustfs.localhost} {
        import access-log
        # Root console credentials are accepted only through HTTPS.
        respond 404
    }
	http://:80 {
		import access-log
		route {
			@health path /health
			respond @health 200
			import operator-deny
			import upstream
		}
	}
	https://{$BP_EDGE_HOST}, https://localhost, https://127.0.0.1 {
		tls internal
		import access-log
		route {
			import operator-deny
			import upstream
		}
	}
}

(mode-public) {
    import rustfs-public-{$BP_RUSTFS_CONSOLE:false}
    http://{$BP_RUSTFS_HOST:rustfs.localhost} {
        import access-log
        route {
            import rustfs-access
            redir {$BP_RUSTFS_URL:https://rustfs.localhost}{uri} 308
        }
    }
	:80 {
		import access-log
		route {
			@health path /health
			respond @health 200
			import operator-deny
			redir {$BP_PUBLIC_URL}{uri} 308
		}
	}
	https://{$BP_EDGE_HOST} {
		tls {
			issuer acme
		}
		header Strict-Transport-Security "max-age=31536000"
		import access-log
		route {
			import operator-deny
			import upstream
		}
	}
}

# Shared ingress owns TLS; the configured public origin owns auth policy.
(mode-proxy) {
    http://:80 {
        import access-log
        route {
            @rustfs expression `(host('{$BP_RUSTFS_HOST:rustfs.localhost}') && !host('{$BP_RUSTFS_URL_HOST:unused.invalid}')) || {http.request.hostport} == '{$BP_RUSTFS_AUTHORITY}'`
            handle @rustfs {
                import rustfs-routes
            }
            @health path /health
            respond @health 200
            import operator-deny
            import upstream
        }
    }
}

import mode-{$BP_ACCESS_MODE}
