{
	auto_https disable_redirects
	skip_install_trust
	# IP clients omit SNI; Docker forwards to a container address.
	default_sni 127.0.0.1
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

(operator-deny) {
	@operator path_regexp (?i)^/+(health/+operations|metrics)\.*(/|$)
	respond @operator 404
	@ready path /health/ready /health/ready/*
	request_header @ready -Authorization
}

# The server builds the Status Document (docs/operations/health.md); Caddy keeps the public transport rules.
(public-status) {
	handle /status.json {
		route {
			header Cache-Control "no-store"
			header -ETag
			header -Accept-Ranges
			header -Last-Modified
			@status_method not method GET HEAD
			header @status_method Allow "GET, HEAD"
			respond @status_method "" 405
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -Cookie
			request_header -If-Match
			request_header -If-Unmodified-Since
			request_header -If-None-Match
			request_header -If-Modified-Since
			request_header -Range
			request_header -If-Range
			import upstream
		}
	}
	# The Caddy component's health path: Caddy answering is its probe.
	handle /health/caddy {
		header Cache-Control "no-store"
		respond "" 200
	}
}

(upstream) {
	# Plaintext upstreams require a trusted host and Docker peers (ADR-0021).
	reverse_proxy server:3000 {
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -X-Real-IP
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
	}
}

(mode-local) {
	http://:80 {
		import access-log
		route {
			@health path /health
			respond @health 200
			import public-status
			import operator-deny
			import upstream
		}
	}
	https://{$BP_EDGE_HOST}, https://localhost, https://127.0.0.1 {
		tls internal
		import access-log
		route {
			import public-status
			import operator-deny
			import upstream
		}
	}
}

(mode-public) {
	:80 {
		import access-log
		route {
			@health path /health
			respond @health 200
			import public-status
			import operator-deny
			redir {$BP_PUBLIC_URL}{uri} 308
		}
	}
	https://{$BP_EDGE_HOST} {
		tls {
			issuer acme
		}
		header Strict-Transport-Security "max-age=31536000"
		import access-log
		route {
			import public-status
			import operator-deny
			import upstream
		}
	}
}

# Standalone modes only; behind Platform Edge the server is the ingress target.
import mode-{$BP_ACCESS_MODE}
