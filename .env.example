# scripts/bootstrap.py copies this file to .env on the first run and fills in the blanks.
# A fresh install is minimal: Postgres, the server and filesystem Files. Add --profile blobs
# (RustFS Files), --profile compute (Functions) or --profile edge (standalone Caddy) to select more.
# Bootstrap records COMPOSE_PROJECT_NAME, COMPOSE_FILE, COMPOSE_PROFILES and BP_BLOB_BACKEND;
# the recorded selection wins on rerun and a conflicting --profile set is refused.
# Bootstrap never changes the capabilities or Files backend of an existing installation.

# Server login URL for a server run outside Compose; Compose builds it from BP_POSTGRES_PASSWORD.
BP_DATABASE_URL=
# PostgreSQL superuser password for migrations and helpers; bootstrap generates it once.
BP_POSTGRES_ADMIN_PASSWORD=
# Password of the bp_server login role; bootstrap generates it once.
BP_POSTGRES_PASSWORD=
# Loopback port for PostgreSQL, published only by compose.dev.yaml.
BP_POSTGRES_PORT=5432
# Direct loopback port for the API, SSE and dashboard.
BP_PORT=3000
# Durable state for a server outside Compose and bootstrap's launch evidence, relative to this file; Compose uses /data.
BP_DATA_DIR=./data
# Signs sessions: random, at least 32 characters, never reused; bootstrap generates it once.
BP_AUTH_SECRET=
# local (HTTP, self-signed HTTPS with the edge profile), public (ACME for your domain) or proxy (behind Platform Edge).
BP_ACCESS_MODE=local
# The one browser and authentication origin; bootstrap derives it in local and public modes.
BP_PUBLIC_URL=
# Your domain in public mode (hostname backplane.<domain>); local mode defaults to backplane.localhost.
BP_PUBLIC_DOMAIN=
# Standalone edge interface; 0.0.0.0 for public access, while the core API stays on loopback.
BP_BIND_HOST=127.0.0.1
# Standalone edge HTTP listener port.
BP_HTTP_PORT=80
# Standalone edge HTTPS listener port.
BP_HTTPS_PORT=443
# Encrypted off-host backup mount; the server reads it read-only. Bootstrap defaults to ./backups.
BP_BACKUP_DIR=
# Bearer token for /health/operations and /metrics on the loopback port; bootstrap generates it once.
BP_OPERATIONS_TOKEN=
# closed (default): the first User enrolls once with the capability file, then no self-service sign-up.
BP_SIGNUP=closed
# How often the server purges expired payloads: a positive integer with ms, s, m or h.
BP_RETENTION_PURGE_INTERVAL=1h

# Shared external Docker network that Platform Edge and the sibling stacks join.
BP_PLATFORM_NETWORK=platform
# Platform Network IPv4 subnet; every stack on this host must use the same value.
BP_PLATFORM_SUBNET=172.30.0.0/24
# Dynamic container address range inside the subnet; Edge's reserved address stays outside it.
BP_PLATFORM_IP_RANGE=172.30.0.128/25
# Prefix for this installation's durable Docker volumes.
BP_VOLUME_PREFIX=agent-backplane
# Number of complete Checkpoints retained.
BP_BACKUP_KEEP=7
# Seconds budgeted for complete storage verification on startup and checkpoint resume/restore (1..86400).
BP_STARTUP_VERIFY_TIMEOUT=120

# PostgreSQL and backup helper image experiment; empty keeps the shipped PostgreSQL 18 pin.
BP_POSTGRES_IMAGE=
# Server, migration and data helper image; empty keeps the published digest pin.
BP_SERVER_IMAGE=
# Standalone edge image experiment; empty keeps the shipped Caddy pin.
BP_CADDY_IMAGE=
# Blob store image experiment; empty keeps the shipped RustFS pin.
BP_RUSTFS_IMAGE=
# Blob helper code experiment; empty uses the effective server image.
BP_BLOB_BOOTSTRAP_IMAGE=
# RustFS root user for humans and the isolated bucket bootstrap, never for agents; generated with blobs.
BP_RUSTFS_ROOT_USER=
# RustFS root password; generated with blobs.
BP_RUSTFS_ROOT_PASSWORD=
# Bucket-scoped S3 access key the server uses; generated with blobs.
BP_BLOB_S3_ACCESS_KEY=
# Bucket-scoped S3 secret key (at most 40 characters for RustFS); generated with blobs.
BP_BLOB_S3_SECRET_KEY=
# S3 bucket for Files; empty uses backplane. Never enable versioning on it.
BP_BLOB_S3_BUCKET=

# Functions image override; must exist locally, never built over or pulled; empty pulls the published amd64 pin.
BP_WORKERD_IMAGE=
# Expected /usr/bin/workerd SHA-256; the default is the verified amd64 1.20260918.1 binary.
BP_WORKERD_BINARY_SHA256=f31da6d248028d698806aa93d1b3aec28bbd4b4b7ddc31e967408ab6406fa5aa
# Private compute control bearer token; bootstrap generates it when compute is selected.
BP_COMPUTE_TOKEN=
# Compute control URL for a server outside Compose (HTTPS or loopback HTTP; receives the token); empty disables compute.
BP_COMPUTE_URL=
# Expected namespaced executable identity for a server outside Compose; the overlay derives it.
BP_WORKERD_RUNTIME_ID=
# Maximum invocation deadline in milliseconds; it does not terminate workerd CPU execution.
BP_COMPUTE_TIMEOUT_MS=10000
# Host declaration for bare Compose: local image config ID sha256:<64 hex>; empty means unknown.
BP_WORKERD_HOST_IMAGE_ID=
# BP_WORKERD_EFFECTIVE_IMAGE is bootstrap's child-process setting; bootstrap refuses it here.
