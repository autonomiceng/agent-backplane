# Server login role: non-superuser, writes only through the audited functions.
# Set explicitly for local development; Compose supplies the generated credential.
BP_DATABASE_URL=
# Direct loopback port for the API, SSE and dashboard.
BP_PORT=3000
# Durable non-database state (enrollment, migration projections, blobs).
# Host bootstrap also stores private launch evidence under this directory/compute.
# Relative host paths resolve beside the bootstrap env file. Compose server uses /data.
BP_DATA_DIR=./data
# Signs sessions. Random, at least 32 characters, never reused across deployments.
BP_AUTH_SECRET=
# local: HTTP and self-signed HTTPS, no domain needed (HTTPS needs the edge profile).
# public: automatically renewed trusted HTTPS certificates for your own domain.
# proxy: behind another gateway; it handles HTTPS and this stack receives HTTP internally.
BP_ACCESS_MODE=local
# One browser and authentication origin. Preparation derives it for local/public modes.
# Behind another gateway, set its externally reachable backplane URL here.
BP_PUBLIC_URL=
# Your domain in public mode. The application hostname is backplane.<domain>.
# Optional in local mode; the default hostname is backplane.localhost.
BP_PUBLIC_DOMAIN=
# Standalone edge interface. Set 0.0.0.0 for public access; the core API stays on loopback.
BP_BIND_HOST=127.0.0.1
# Standalone edge ports. Core-only access remains HTTP on BP_PORT (default 3000).
BP_HTTP_PORT=80
# Standalone HTTPS listener port.
BP_HTTPS_PORT=443
# Encrypted off-host backup mount. Required by compose; the server reads it read-only.
BP_BACKUP_DIR=
# Bearer token for /health/operations and /metrics on the loopback port. Optional.
BP_OPERATIONS_TOKEN=
# closed (default): the first User enrolls once with the capability file, then no self-service sign-up.
BP_SIGNUP=closed

# Shared external network and durable volume namespace.
BP_PLATFORM_NETWORK=platform
# Prefix for this installation's durable Docker volumes.
BP_VOLUME_PREFIX=agent-backplane
# Number of complete Checkpoints retained.
BP_BACKUP_KEEP=7

# PostgreSQL and backup helper image experiment; empty keeps the shipped PostgreSQL 18 pin.
BP_POSTGRES_IMAGE=
# Server, migration and data helper image; empty keeps the checkout-built local image.
BP_SERVER_IMAGE=
# Standalone edge and internal gateway image experiment; empty keeps the shipped Caddy pin.
BP_CADDY_IMAGE=
# Blob store image experiment; empty keeps the shipped RustFS pin.
BP_RUSTFS_IMAGE=
# Explicit blob helper code experiment; empty uses the effective server image.
BP_BLOB_BOOTSTRAP_IMAGE=

# Required for --profile compute: full locally available image reference; no shipped default.
# Local example: agent-backplane-workerd:1.20260918.1. Empty refuses compute preparation.
# Tags may move on a later bare Compose deployment. Use an immutable reference to repeat content.
BP_WORKERD_IMAGE=
# Expected executable SHA-256. Empty uses the verified amd64 1.20260918.1 binary below.
# Other architectures require an explicit verified hash and separate runtime qualification.
BP_WORKERD_BINARY_SHA256=f31da6d248028d698806aa93d1b3aec28bbd4b4b7ddc31e967408ab6406fa5aa
# Private compute control bearer token. Bootstrap generates this when compute is selected.
BP_COMPUTE_TOKEN=
# Optional compute control URL for running the server outside Compose. Empty disables compute.
# The overlay supplies http://workerd:8080 on its private network.
BP_COMPUTE_URL=
# Expected namespaced executable identity for a server outside Compose; overlay derives it.
BP_WORKERD_RUNTIME_ID=
# Maximum invocation deadline in milliseconds; does not terminate workerd CPU execution.
BP_COMPUTE_TIMEOUT_MS=10000
# Optional HOST DECLARATION for bare Compose: local Docker image config ID, sha256:<64 hex>.
# Empty means unknown. Never infer it from a tag or confuse it with a registry manifest digest.
# Bootstrap supplies its inspected ID only in the child environment for that launch.
BP_WORKERD_HOST_IMAGE_ID=
# BP_WORKERD_EFFECTIVE_IMAGE is reserved for bootstrap's child process. Do not persist it:
# a persistent value would mask future BP_WORKERD_IMAGE edits. No evidence file selects images.
